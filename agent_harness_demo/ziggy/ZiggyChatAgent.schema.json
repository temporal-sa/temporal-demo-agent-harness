{
  "agent": "ZiggyChatAgent",
  "source": "agent_harness_demo.ziggy.conversational_workflow:ZiggyChatAgentWorkflow",
  "init_data": {
    "data": {
      "$ref": "#/$defs/TravelerContext"
    },
    "required": false
  },
  "handlers": {
    "ask": {
      "description": "Chat with the travel assistant. Describe the trip you want (flights, hotels,\ndates, traveler name) in plain text; the assistant converses, writes and runs Python\nscripts against a simulated travel backend as needed, and replies with the results.",
      "mid_turn": "enqueue",
      "input": {
        "$ref": "#/$defs/TextMessage"
      },
      "output": {
        "$ref": "#/$defs/TextReply"
      }
    },
    "set_approval_policy": {
      "description": "Update the agent's tool approval policy.",
      "mid_turn": "accept",
      "input": {
        "$ref": "#/$defs/PolicyUpdate"
      },
      "output": {
        "$ref": "#/$defs/TextReply"
      }
    },
    "set_model": {
      "description": "Set the model this session uses for subsequent turns. Takes effect on the next\nmodel call, so a turn already in flight finishes on the model it started with.",
      "mid_turn": "accept",
      "input": {
        "$ref": "#/$defs/SetModel"
      },
      "output": {
        "$ref": "#/$defs/TextReply"
      }
    }
  },
  "states": {
    "trip_board": {
      "$ref": "#/$defs/TripBoard"
    }
  },
  "$defs": {
    "Booking": {
      "additionalProperties": false,
      "description": "A flight or hotel this trip has actually booked.",
      "properties": {
        "kind": {
          "enum": [
            "flight",
            "hotel"
          ],
          "title": "Kind",
          "type": "string"
        },
        "confirmation_code": {
          "title": "Confirmation Code",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "price_usd": {
          "default": 0.0,
          "title": "Price Usd",
          "type": "number"
        },
        "fare": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fare"
        },
        "seat": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seat"
        }
      },
      "required": [
        "kind",
        "confirmation_code",
        "detail",
        "price_usd",
        "fare",
        "seat"
      ],
      "title": "Booking",
      "type": "object"
    },
    "PolicyUpdate": {
      "description": "Selected tool approval policy name.",
      "properties": {
        "new_policy": {
          "enum": [
            "allow_safe",
            "strict",
            "dangerously_skip_all"
          ],
          "title": "New Policy",
          "type": "string"
        }
      },
      "required": [
        "new_policy"
      ],
      "title": "PolicyUpdate",
      "type": "object"
    },
    "SetModel": {
      "description": "Which model this Ziggy session should use for subsequent turns.",
      "properties": {
        "model": {
          "enum": [
            "gemini-3.8-flash",
            "gemini-3.1-flash-lite"
          ],
          "title": "Model",
          "type": "string"
        }
      },
      "required": [
        "model"
      ],
      "title": "SetModel",
      "type": "object"
    },
    "TextMessage": {
      "description": "Free-form natural-language text from the user (the input to a plain chat handler).",
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "TextMessage",
      "type": "object"
    },
    "TextReply": {
      "description": "A free-form natural-language reply (the output of a plain chat handler).",
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "TextReply",
      "type": "object"
    },
    "TravelerContext": {
      "description": "Where the traveler is in time, sent once when a conversation starts.\n\nA model only knows the date it was trained up to, so without this it plans trips in the\npast. The demo view sends the traveler's own date and time zone; a session started\nwithout it falls back to the Workflow's clock, in UTC.",
      "properties": {
        "today": {
          "description": "The traveler's local date when the conversation started.",
          "format": "date",
          "title": "Today",
          "type": "string"
        },
        "timezone": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_]+(/[A-Za-z0-9_+-]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The traveler's IANA time zone, such as America/New_York.",
          "title": "Timezone"
        }
      },
      "required": [
        "today"
      ],
      "title": "TravelerContext",
      "type": "object"
    },
    "Trip": {
      "additionalProperties": false,
      "description": "One trip the agent is collecting.",
      "properties": {
        "trip_id": {
          "title": "Trip Id",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "traveler": {
          "title": "Traveler",
          "type": "string"
        },
        "status": {
          "default": "collecting",
          "enum": [
            "collecting",
            "booked",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        },
        "flights": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Booking"
          },
          "title": "Flights",
          "type": "array"
        },
        "hotels": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Booking"
          },
          "title": "Hotels",
          "type": "array"
        },
        "remaining": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TripTask"
          },
          "title": "Remaining",
          "type": "array"
        }
      },
      "required": [
        "trip_id",
        "description",
        "traveler",
        "status",
        "flights",
        "hotels",
        "remaining"
      ],
      "title": "Trip",
      "type": "object"
    },
    "TripBoard": {
      "additionalProperties": false,
      "description": "Every trip this session is working on, newest last.",
      "properties": {
        "trips": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Trip"
          },
          "title": "Trips",
          "type": "array"
        }
      },
      "required": [
        "trips"
      ],
      "title": "TripBoard",
      "type": "object"
    },
    "TripTask": {
      "additionalProperties": false,
      "description": "One thing the trip still needs, and whether it has been done.",
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "done": {
          "default": false,
          "title": "Done",
          "type": "boolean"
        }
      },
      "required": [
        "text",
        "done"
      ],
      "title": "TripTask",
      "type": "object"
    }
  }
}
